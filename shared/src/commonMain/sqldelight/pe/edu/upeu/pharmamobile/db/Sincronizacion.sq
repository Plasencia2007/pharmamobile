-- Instante de la ultima sincronizacion correcta (Actividad autonoma 11).
-- Una sola fila: el CHECK impide que haya mas de una y el INSERT OR REPLACE
-- la sobrescribe en cada sincronizacion. Sin fila = nunca se sincronizo.
CREATE TABLE sincronizacion (
    id        INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    instante  INTEGER NOT NULL
);

ultima:
SELECT instante FROM sincronizacion WHERE id = 1;

registrar:
INSERT OR REPLACE INTO sincronizacion (id, instante) VALUES (1, ?);
