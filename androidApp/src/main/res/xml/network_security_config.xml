<?xml version="1.0" encoding="utf-8"?>
<!--
  Habilita trafico HTTP sin cifrar solo hacia 10.0.2.2 (el alias del
  emulador para el localhost de la maquina host), donde corre el backend
  PharmaSoft en desarrollo. El resto del trafico sigue exigiendo HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
